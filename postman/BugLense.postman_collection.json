        {
          "name": "Test Case Generator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "const json = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response contains testCases array\", function () {\r",
                  "    pm.expect(json).to.have.property(\"testCases\");\r",
                  "    pm.expect(json.testCases).to.be.an(\"array\");\r",
                  "    pm.expect(json.testCases.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Every test case contains required fields\", function () {\r",
                  "    json.testCases.forEach(tc => {\r",
                  "        pm.expect(tc).to.have.all.keys(\r",
                  "            \"id\",\r",
                  "            \"feature\",\r",
                  "            \"title\",\r",
                  "            \"description\",\r",
                  "            \"type\",\r",
                  "            \"severity\",\r",
                  "            \"priority\",\r",
                  "            \"status\",\r",
                  "            \"preconditions\",\r",
                  "            \"steps\",\r",
                  "            \"expectedResult\"\r",
                  "        );\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Every test case has valid ID\", function () {\r",
                  "    json.testCases.forEach(tc => {\r",
                  "        pm.expect(tc.id).to.match(/^TC-\\d{3}$/);\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Every test case has preconditions and steps arrays\", function () {\r",
                  "    json.testCases.forEach(tc => {\r",
                  "        pm.expect(tc.preconditions).to.be.an(\"array\");\r",
                  "        pm.expect(tc.steps).to.be.an(\"array\");\r",
                  "        pm.expect(tc.steps.length).to.be.above(0);\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Test case types are valid\", function () {\r",
                  "    const validTypes = [\r",
                  "        \"Positive\",\r",
                  "        \"Negative\",\r",
                  "        \"Edge Case\",\r",
                  "        \"Regression\"\r",
                  "    ];\r",
                  "\r",
                  "    json.testCases.forEach(tc => {\r",
                  "        pm.expect(validTypes).to.include(tc.type);\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Severity values are valid\", function () {\r",
                  "    const validValues = [\"Low\", \"Medium\", \"High\", \"Critical\"];\r",
                  "\r",
                  "    json.testCases.forEach(tc => {\r",
                  "        pm.expect(validValues).to.include(tc.severity);\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Priority values are valid\", function () {\r",
                  "    const validValues = [\"Low\", \"Medium\", \"High\", \"Critical\"];\r",
                  "\r",
                  "    json.testCases.forEach(tc => {\r",
                  "        pm.expect(validValues).to.include(tc.priority);\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Important text fields are not empty\", function () {\r",
                  "    json.testCases.forEach(tc => {\r",
                  "        pm.expect(tc.title.trim()).to.not.equal(\"\");\r",
                  "        pm.expect(tc.description.trim()).to.not.equal(\"\");\r",
                  "        pm.expect(tc.expectedResult.trim()).to.not.equal(\"\");\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Test case IDs are unique\", function () {\r",
                  "    const ids = json.testCases.map(tc => tc.id);\r",
                  "    const uniqueIds = new Set(ids);\r",
                  "\r",
                  "    pm.expect(uniqueIds.size).to.equal(ids.length);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
