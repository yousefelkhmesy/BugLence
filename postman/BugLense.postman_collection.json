        {
          "name": "Requirement Analyzer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "const json = pm.response.json();\r",
                  "\r",
                  "pm.test(\"All analysis sections exist\", function () {\r",
                  "    pm.expect(json).to.have.property(\"ambiguities\");\r",
                  "    pm.expect(json).to.have.property(\"missingInfo\");\r",
                  "    pm.expect(json).to.have.property(\"risks\");\r",
                  "    pm.expect(json).to.have.property(\"testScenarios\");\r",
                  "    pm.expect(json).to.have.property(\"edgeCases\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"All analysis sections are arrays\", function () {\r",
                  "    pm.expect(json.ambiguities).to.be.an(\"array\");\r",
                  "    pm.expect(json.missingInfo).to.be.an(\"array\");\r",
                  "    pm.expect(json.risks).to.be.an(\"array\");\r",
                  "    pm.expect(json.testScenarios).to.be.an(\"array\");\r",
                  "    pm.expect(json.edgeCases).to.be.an(\"array\");\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
